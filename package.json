{
  "name": "edge-uptime-monitor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "build": "vite build",
    "verify": "bun run scripts/verify.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run verify",
    "db:migrate:local": "wrangler d1 migrations apply edge-uptime --local",
    "monitor": "bun run scripts/monitor.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
